<Application x:Class="FirawH4K.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Application.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#080D16" />
        <SolidColorBrush x:Key="PanelBackground" Color="#0D1723" />
        <SolidColorBrush x:Key="PanelBorder" Color="#203246" />
        <SolidColorBrush x:Key="Accent" Color="#22D3EE" />
        <SolidColorBrush x:Key="AccentBlue" Color="#67E8F9" />
        <SolidColorBrush x:Key="TextMain" Color="#DCE9F3" />
        <SolidColorBrush x:Key="TextMuted" Color="#8094A9" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#080D16" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#263247" />
                    <Setter Property="Foreground" Value="#71819A" />
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="#142535" />
            <Setter Property="BorderBrush" Value="#2A7989" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid>
                                    <ContentPresenter x:Name="SelectionContent" Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="10,0,34,0" VerticalAlignment="Center"
                                                      TextElement.Foreground="{StaticResource TextMain}" />
                                    <ToggleButton x:Name="DropDownToggle" HorizontalAlignment="Right" Width="32"
                                                  Background="Transparent" BorderThickness="0" Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Grid Background="Transparent">
                                                    <Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="{StaticResource Accent}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="DropDownPopup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="#142535" BorderBrush="#22D3EE" BorderThickness="1" CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="#142535" />
            <Setter Property="Padding" Value="8,7" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1C3B49" />
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A7989" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="#17243A" />
            <Setter Property="BorderBrush" Value="#345070" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Application.Resources>
</Application>
