<Window x:Class="FirawH4K.TelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="490" Height="318" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" IsHitTestVisible="False">
    <Grid x:Name="MonitorRoot" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="MonitorScale" ScaleX="1" ScaleY="1" />
                <SkewTransform x:Name="MonitorSkew" AngleX="0" />
                <RotateTransform x:Name="MonitorRotation" Angle="0" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Border x:Name="MonitorPanel" CornerRadius="8" BorderThickness="1.5" BorderBrush="#359F71" Background="#F5040A0C">
            <Border.Effect><DropShadowEffect Color="#35F0A3" BlurRadius="24" ShadowDepth="0" Opacity="0.45" /></Border.Effect>
            <Grid Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="43" /><RowDefinition Height="1" /><RowDefinition Height="112" />
                    <RowDefinition Height="8" /><RowDefinition Height="89" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="FIRAW // HARDWARE MONITOR" Foreground="#AEFFD4" FontFamily="Consolas" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="LOCAL SYSTEM  /  TELEMETRIA DO WINDOWS" Foreground="#688B7F" FontFamily="Consolas" FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="●  LIVE" Foreground="#47EA9F" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <Border Grid.Row="1" Background="#32644F" />
                <Grid Grid.Row="2" Margin="0,11,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#111B1C" BorderBrush="#284A3A" BorderThickness="1" CornerRadius="4" Padding="10,7">
                        <Grid>
                            <TextBlock Text="CPU  /  UTILIZAÇÃO" Foreground="#729988" FontFamily="Consolas" FontSize="10" />
                            <TextBlock x:Name="CpuText" Text="--%" Foreground="#89FFC1" FontFamily="Consolas" FontSize="31" FontWeight="Bold" Margin="0,17,0,0" />
                            <Canvas Height="33" VerticalAlignment="Bottom" ClipToBounds="True"><Polyline x:Name="CpuGraph" Stroke="#4FF0A0" StrokeThickness="1.6" /></Canvas>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="#111B1C" BorderBrush="#284A3A" BorderThickness="1" CornerRadius="4" Padding="10,7">
                        <Grid>
                            <TextBlock Text="MEMÓRIA  /  CONSUMO" Foreground="#729988" FontFamily="Consolas" FontSize="10" />
                            <TextBlock x:Name="MemoryText" Text="--%" Foreground="#89FFC1" FontFamily="Consolas" FontSize="31" FontWeight="Bold" Margin="0,17,0,0" />
                            <TextBlock x:Name="MemoryDetail" Text="-- / -- GB" Foreground="#7B998A" FontFamily="Consolas" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#0C1315" BorderBrush="#263A33" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="TEMPERATURA CPU" Foreground="#789888" FontFamily="Consolas" FontSize="10" />
                            <TextBlock Text="N/D" Foreground="#91B4A1" FontFamily="Consolas" FontSize="22" Margin="0,3,0,0" />
                            <TextBlock Text="sensor não disponível" Foreground="#5F786A" FontFamily="Consolas" FontSize="9" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#0C1315" BorderBrush="#263A33" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="POTÊNCIA / CONSUMO" Foreground="#789888" FontFamily="Consolas" FontSize="10" />
                            <TextBlock Text="N/D" Foreground="#91B4A1" FontFamily="Consolas" FontSize="22" Margin="0,3,0,0" />
                            <TextBlock Text="sensor não disponível" Foreground="#5F786A" FontFamily="Consolas" FontSize="9" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="5" Text="LEITURAS REAIS: CPU + RAM   /   SEM SENSOR: N/D" Foreground="#678678" FontFamily="Consolas" FontSize="9" VerticalAlignment="Bottom" />
            </Grid>
        </Border>
        <Canvas x:Name="AssemblyCanvas" Width="490" Height="318" IsHitTestVisible="False">
            <Rectangle x:Name="AssemblyTop" Width="410" Height="3" Fill="#7CFFBA" Canvas.Left="40" Canvas.Top="15" />
            <Rectangle x:Name="AssemblyLeft" Width="3" Height="250" Fill="#40D698" Canvas.Left="11" Canvas.Top="34" />
            <Rectangle x:Name="AssemblyRight" Width="3" Height="250" Fill="#40D698" Canvas.Left="476" Canvas.Top="34" />
            <Rectangle x:Name="AssemblyBottom" Width="410" Height="3" Fill="#7CFFBA" Canvas.Left="40" Canvas.Top="301" />
        </Canvas>
    </Grid>
</Window>
