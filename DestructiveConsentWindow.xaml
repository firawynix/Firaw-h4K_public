<Window x:Class="FirawH4K.DestructiveConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firaw - h4K | Aceite do modo destrutivo"
        Width="560" Height="540" MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#080D16" Foreground="#DCE9F3">
    <Border Margin="18" Padding="24" CornerRadius="12" Background="#0D1723" BorderBrush="#22D3EE" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="FIRAW // MODO DESESPERO" FontFamily="Consolas" FontSize="23" FontWeight="Bold" Foreground="#67E8F9" />
                <TextBlock Text="Leia antes de ativar" Margin="0,4,0,0" Foreground="#AFC5BE" FontSize="13" />
            </StackPanel>
            <Border Grid.Row="1" Height="1" Background="#2A7989" Margin="0,17,0,16" />
            <StackPanel Grid.Row="2">
                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22"
                           Text="O modo cria uma cena fictícia com moldura sombria, impactos visuais e dois besouros. Cada impacto distorce por instantes uma pequena parte da imagem; o restante do computador continua em movimento. Nenhum arquivo da área de trabalho é alterado ou salvo." />
                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" Margin="0,14,0,0"
                           Text="Este modo bloqueia mouse e teclado e oculta o ponteiro, sem limite de tempo. Pressione Ctrl+Alt+F12 para encerrar e liberar os controles. Ctrl+Alt+Del continua disponível pelo Windows. Há luzes piscantes: não ative se for sensível a flashes. Use somente no seu computador e com consentimento de quem estiver usando." />
                <CheckBox x:Name="ConsentCheck" Content="Entendi a trava e o atalho; quero ativar." Margin="0,20,0,0"
                          Foreground="#DDF7E9" FontSize="14" Checked="ConsentCheck_Changed" Unchecked="ConsentCheck_Changed" />
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="CANCELAR" IsCancel="True" Width="110" Height="39" Margin="0,0,10,0"
                        Background="#253341" Foreground="#E8F5EF" BorderBrush="#526371" />
                <Button x:Name="AcceptButton" Content="ACEITAR E ATIVAR" Width="165" Height="39" Opacity="0.62"
                        Background="#22D3EE" Foreground="#080D16" BorderBrush="#22D3EE" FontWeight="Bold" Click="AcceptButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
