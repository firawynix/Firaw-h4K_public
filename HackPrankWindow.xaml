<Window x:Class="FirawH4K.HackPrankWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="690" Height="530"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        IsHitTestVisible="False">
        <Border x:Name="ShellBorder" CornerRadius="3" BorderThickness="1.4"
            BorderBrush="#2C6D51" Background="#FF010404" Padding="14">
        <Border.Effect><DropShadowEffect Color="#0BC971" BlurRadius="26" ShadowDepth="0" Opacity="0.38" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="105" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True">
                <TextBlock x:Name="LiveText" DockPanel.Dock="Right" Text="● LIVE   ·   FIRAW FX"
                           FontFamily="Consolas" FontSize="11" Foreground="#42F5B3"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Text="FIRAW SHELL // BEETLE 01"
                           FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                           Foreground="#8DFFD5" VerticalAlignment="Center" />
            </DockPanel>
            <Border Grid.Row="1" BorderBrush="#1F503B" BorderThickness="1" Padding="6">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#010505" Offset="0" />
                        <GradientStop Color="#071910" Offset="0.53" />
                        <GradientStop Color="#010303" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock Text="01001101  10100011  00101110  11010010  00110101  10111000  0110" FontFamily="Consolas" FontSize="10"
                               Foreground="#34513D" HorizontalAlignment="Center" VerticalAlignment="Top" />
                    <TextBlock x:Name="AsciiArt" FontFamily="Consolas" FontSize="11.5" LineHeight="11.4"
                               TextAlignment="Center" VerticalAlignment="Center" Foreground="#3DB976"
                               TextOptions.TextFormattingMode="Display">
                        <TextBlock.Effect><DropShadowEffect Color="#15DB70" BlurRadius="8" ShadowDepth="0" Opacity="0.48" /></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="FRAME 0xA4F2   ·   01100110 10101001 00110010   ·   GHOST LINK" FontFamily="Consolas" FontSize="10"
                               Foreground="#34513D" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,9,0,0">
                <TextBlock x:Name="PromptText" Text="firaw@display:~$ ./beetle --visual"
                           FontFamily="Consolas" FontSize="12" Foreground="#8DFFD5" />
                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="11.5" LineHeight="15"
                           Foreground="#42F5B3" Margin="0,5,0,0" />
                <TextBlock x:Name="ProgressText" FontFamily="Consolas" FontSize="11.5"
                           Foreground="#8DFFD5" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
