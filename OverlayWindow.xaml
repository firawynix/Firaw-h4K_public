<Window x:Class="FirawH4K.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="250"
        Height="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False">
    <Canvas x:Name="AvatarCanvas" Width="250" Height="250" Opacity="0">
        <Canvas.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="0.35" ScaleY="0.35" />
                <TranslateTransform X="-28" Y="18" />
            </TransformGroup>
        </Canvas.RenderTransform>
        <Ellipse x:Name="ActivationRing" Canvas.Left="28" Canvas.Top="28" Width="194" Height="194"
                 Fill="Transparent" Stroke="#42F5B3" StrokeThickness="3" Opacity="0" />
        <Ellipse Canvas.Left="42" Canvas.Top="220" Width="166" Height="18"
                 Fill="#3042F5B3" Stroke="#42F5B3" StrokeThickness="1" Opacity="0.25"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Canvas x:Name="RiftCanvas" Canvas.Left="20" Canvas.Top="84" Width="210" Height="102" Opacity="0"
                IsHitTestVisible="False">
            <Ellipse x:Name="RiftGlow" Canvas.Left="8" Canvas.Top="22" Width="194" Height="58"
                     Fill="#661DFA9A" Stroke="#42F5B3" StrokeThickness="2" />
            <Ellipse Canvas.Left="22" Canvas.Top="36" Width="166" Height="30"
                     Fill="#EE020711" Stroke="#00FF7F" StrokeThickness="1" />
            <Ellipse Canvas.Left="46" Canvas.Top="45" Width="118" Height="12"
                     Fill="#FF000000" Opacity="0.9" />
            <Line X1="28" Y1="45" X2="6" Y2="10" Stroke="#7CFFD1" StrokeThickness="2" />
            <Line X1="182" Y1="45" X2="204" Y2="8" Stroke="#7CFFD1" StrokeThickness="2" />
            <Line X1="58" Y1="32" X2="34" Y2="4" Stroke="#38EFA7" StrokeThickness="1" />
            <Line X1="152" Y1="32" X2="176" Y2="4" Stroke="#38EFA7" StrokeThickness="1" />
        </Canvas>
        <Canvas x:Name="BeetleRig" Canvas.Left="15" Canvas.Top="8" Width="220" Height="220"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                    <RotateTransform Angle="0" />
                    <TranslateTransform X="0" Y="0" />
                    <SkewTransform AngleX="0" AngleY="0" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Image x:Name="CursorMascot" Source="Assets/cyber-beetle-h4k-dark.png" Width="220" Height="220" Stretch="Uniform" />
            <!-- Recortes estreitos: somente as pernas recebem movimento; o corpo não é duplicado. -->
            <Canvas x:Name="LeftFrontLeg" Width="220" Height="220" Clip="M 17,34 L 66,34 L 66,108 L 17,108 Z" IsHitTestVisible="False">
                <Image x:Name="LeftFrontImage" Source="Assets/cyber-beetle-h4k-dark.png" Width="220" Height="220" Stretch="Uniform" />
            </Canvas>
            <Canvas x:Name="LeftMiddleLeg" Width="220" Height="220" Clip="M 18,91 L 72,91 L 72,158 L 18,158 Z" IsHitTestVisible="False">
                <Image x:Name="LeftMiddleImage" Source="Assets/cyber-beetle-h4k-dark.png" Width="220" Height="220" Stretch="Uniform" />
            </Canvas>
            <Canvas x:Name="LeftRearLeg" Width="220" Height="220" Clip="M 28,133 L 78,133 L 78,207 L 28,207 Z" IsHitTestVisible="False">
                <Image x:Name="LeftRearImage" Source="Assets/cyber-beetle-h4k-dark.png" Width="220" Height="220" Stretch="Uniform" />
            </Canvas>
            <Canvas x:Name="RightFrontLeg" Width="220" Height="220" Clip="M 154,34 L 203,34 L 203,108 L 154,108 Z" IsHitTestVisible="False">
                <Image x:Name="RightFrontImage" Source="Assets/cyber-beetle-h4k-dark.png" Width="220" Height="220" Stretch="Uniform" />
            </Canvas>
            <Canvas x:Name="RightMiddleLeg" Width="220" Height="220" Clip="M 148,91 L 202,91 L 202,158 L 148,158 Z" IsHitTestVisible="False">
                <Image x:Name="RightMiddleImage" Source="Assets/cyber-beetle-h4k-dark.png" Width="220" Height="220" Stretch="Uniform" />
            </Canvas>
            <Canvas x:Name="RightRearLeg" Width="220" Height="220" Clip="M 142,133 L 192,133 L 192,207 L 142,207 Z" IsHitTestVisible="False">
                <Image x:Name="RightRearImage" Source="Assets/cyber-beetle-h4k-dark.png" Width="220" Height="220" Stretch="Uniform" />
            </Canvas>
        </Canvas>
    </Canvas>
</Window>
